options:
    parameters:
        id: usrp_b2xx_fake
    states:
        coordinate: [0, 0]
        rotation: 0
        state: enabled
blocks:
# Device 'fake' exercises the block's lifecycle, the pending-setter machinery and
# the side module's load path without opening WebUSB or fetching any FPGA image.
-   name: usrp_rx
    id: wasm_usrp_b2xx_source
    parameters:
        device: 'fake:100000'
        samp_rate: '1000000'
        center_freq: '100000000'
        gain: '30'
        bandwidth: '0'
        antenna: 'RX2'
        master_clock_rate: '0'
    states:
        coordinate: [0, 0]
        rotation: 0
        state: enabled
-   name: rx_null
    id: blocks_null_sink
    parameters:
        type: complex
        vlen: '1'
    states:
        coordinate: [250, 0]
        rotation: 0
        state: enabled
connections:
- [usrp_rx, '0', rx_null, '0']
metadata:
    file_format: 1
    grc_version: 3.11.0.0
