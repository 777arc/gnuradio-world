options:
    parameters:
        id: wasm_satellites_deframers
        title: gr-satellites deframer rebuilds
    states:
        coordinate: [0, 0]
        rotation: 0
        state: enabled
blocks:
-   name: noise
    id: analog_noise_source_x
    parameters:
        type: float
        noise_type: analog.GR_GAUSSIAN
        amp: '1'
        seed: '42'
    states:
        coordinate: [0, 0]
        rotation: 0
        state: enabled
-   name: throttle
    id: blocks_throttle2
    parameters:
        ignoretag: 'True'
        limit: auto
        maximum: '0.1'
