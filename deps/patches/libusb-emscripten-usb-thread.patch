-// A helper that proxies a function call to the main thread if not already
+// The one thread every WebUSB call in this backend runs on.
+//
+// It has to be *a* single thread: a USBDevice belongs to the JS realm that
+// created it and cannot be handed to another, so all of libusb's state here is
+// pinned to whichever thread opened the device. Upstream that thread is the
+// browser main thread. Here it is a thread of our own, and the difference is the
+// entire performance story of this backend inside an application that also draws.
+//
+// Chrome does a fixed amount of work *on the thread owning the device* for every
+// byte transferred: the IPC from the USB service into the renderer, then the copy
+// into the wasm heap. On the main thread that competes with rendering, so USB
+// throughput collapses to whatever share of the thread is left over. Measured on
+// a USRP B210 streaming 1 MS/s: ~700 KB/s with two Qt plots on screen, against
+// 77 MB/s for the same radio over the same code with the main thread idle. The
+// cost was proportional to bytes and not to transfers, which is what rules out
+// per-transfer proxying overhead as the explanation and points here instead.
+//
+// WebUSB is exposed in dedicated workers and an Emscripten pthread is one, so the
+// device is opened on a thread that does nothing else. requestDevice() still
+// needs a user gesture and so still happens on the main thread, in the page;
+// getDevices() re-acquires by origin permission here, exactly as this project's
+// hand-written WebUSB workers already do.
+static pthread_t usb_thread_id = 0;
+
+static void* usbThreadMain(void*) {
+	// This thread has a JavaScript realm of its own, and embind's type registry
+	// is per realm. The static initializer above ran in whichever realm dlopen'd
+	// this module, not in this one, so without repeating it here the very first
+	// val to cross from this thread fails with
+	//
+	//     BindingError: parameter 0 has unknown type N10emscripten3valE
+	//
+	// which is what moving off the main thread broke the first time.
+	registerEmbindTypes();
+	// Unwind to the worker's event loop without ending the thread. Proxied work
+	// can only complete on a live runtime (see emscripten/proxying.h), and the
+	// promise callbacks WebUSB delivers need that event loop just as much.
+	emscripten_exit_with_live_runtime();
+	return nullptr;
+}
+
+// Created on first use rather than at load: a process that never touches USB
+// should not hold a worker open, and the pool this comes from is sized by the
+// application.
+//
+// The thread is proved before it is adopted. Everything here depends on a pthread
+// that has exited to the JS event loop continuing to service its proxying queue,
+// and if that ever stops holding, the failure would otherwise be the worst kind:
+// the first transfer proxied into a thread that never answers, and a tab that
+// hangs with no message. So one trivial task is proxied across first, and the
+// main thread -- slower, but what every other build of this backend uses -- is
+// used instead if it does not come back.
+static pthread_t usbThread() {
+	static std::once_flag once;
+	std::call_once(once, [] {
+		usb_thread_id = emscripten_main_runtime_thread_id();
+		pthread_t thread;
+		if (pthread_create(&thread, nullptr, usbThreadMain, nullptr) != 0) {
+			usbi_warn(nullptr, "no worker for the WebUSB thread; using the main "
+							   "thread, which is much slower under load");
+			return;
+		}
+		std::atomic<bool> alive{false};
+		if (queue.proxySync(thread, [&alive] { alive.store(true); }) &&
+			alive.load()) {
+			usb_thread_id = thread;
+		} else {
+			usbi_warn(nullptr, "the WebUSB thread is not servicing its proxying "
+							   "queue; using the main thread instead");
+		}
+	});
+	return usb_thread_id;
+}
+
+static bool onUsbThread() {
+	return pthread_equal(pthread_self(), usbThread()) != 0;
+}
