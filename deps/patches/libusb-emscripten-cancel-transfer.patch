+// Register the embind types this backend passes across the JS boundary.
+//
+// Needed only when libusb is linked into an Emscripten *side module*. embind keys
+// its type registry on TypeID<T>, which with RTTI is &typeid(T), and the registry
+// itself is per-JavaScript-realm. The main module registers its own set at
+// startup (libembind's EMSCRIPTEN_BINDINGS(builtin)) and Emscripten replays that
+// into every pthread, but a side module's typeinfo for these types is a separate
+// object -- so those registrations do not answer lookups made from here, and a
+// val call fails with
+//
+//     BindingError: _emval_take_value has unknown type N10emscripten11memory_viewIhEE
+//
+// It has to be done in *this* translation unit: the id is whatever typeid()
+// yields where the call is made, so registering from a neighbouring file in the
+// same module is not equivalent.
+//
+// A static initializer runs once per realm the module is instantiated in, which
+// is exactly the granularity the registry has. Duplicates are expected wherever
+// the type did unify with the main module's, so they are ignored.
+namespace {
+struct RegisterEmbindTypes {
+	RegisterEmbindTypes() {
+		// NOTE the double underscore: Emscripten's JS name for the C symbol
+		// _embind_register_emval is __embind_register_emval.
+		EM_ASM(
+			{
+				try {
+					__embind_register_emval($0);
+				} catch (error) {
+					// Already registered in this realm.
+				}
+				try {
+					// 1 == embind's TypedArrayIndex::Uint8Array.
+					__embind_register_memory_view($1, 1, $2);
+				} catch (error) {
+				}
+			},
+			emscripten::internal::TypeID<emscripten::val>::get(),
+			emscripten::internal::TypeID<
+				emscripten::memory_view<uint8_t>>::get(),
+			"emscripten::memory_view<uint8_t>");
+	}
+};
+const RegisterEmbindTypes register_embind_types;
+}  // namespace
