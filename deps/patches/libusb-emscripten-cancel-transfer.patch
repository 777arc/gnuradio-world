 int em_cancel_transfer(usbi_transfer* itransfer) {
+	auto pending = findPending(itransfer);
+	if (pending) {
+		std::lock_guard<std::mutex> lock(pending->mutex);
+		pending->owner = nullptr;
+		if (pending->is_read && !pending->delivered.load()) {
+			// The browser read cannot be aborted and its bytes are still
+			// coming. Queue it against the endpoint so the next read adopts it
+			// rather than losing the data -- and, worse, swallowing the reply
+			// to whatever request comes next.
+			std::lock_guard<std::mutex> reg(pending_mutex);
+			orphaned_reads[{pending->dev_handle, pending->endpoint}].push_back(
+				pending);
+		}
+	}
+	// Complete the transfer now rather than waiting for a promise that may never
+	// settle. libusb turns this into LIBUSB_TRANSFER_TIMED_OUT when the
+	// cancellation came from a timeout and LIBUSB_TRANSFER_CANCELLED otherwise,
+	// which is what synchronous callers expect.
+	usbi_signal_transfer_completion(itransfer);
 	return LIBUSB_SUCCESS;
 }
 
