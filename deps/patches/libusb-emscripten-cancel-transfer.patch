+// Cancellation support.
+//
+// WebUSB exposes no way to abort an in-flight transfer: once transferIn() has
+// been called, its promise settles when the device answers, and never before.
+// libusb, meanwhile, implements *every* synchronous-transfer timeout by calling
+// the backend's cancel_transfer and then waiting for completion. The stock
+// backend's cancel_transfer does nothing, so a bulk IN on an endpoint with no
+// data never completes and never times out, and the caller blocks forever. UHD's
+// libusb_zero_copy transport flushes its receive endpoint exactly that way during
+// ordinary device setup, so a USRP B2xx hangs partway through initialisation.
+//
+// We cannot abort the transfer, so we stop *waiting* for it: cancel completes the
+// libusb transfer immediately and leaves the browser read outstanding.
+//
+// That alone would be wrong. The bytes that read will receive are still coming,
+// and simply dropping them loses data that belongs to the endpoint's stream --
+// which shows up as a later request never being answered, because a stale read
+// swallowed its reply. So a cancelled read is not discarded but *orphaned*: it
+// stays queued against its endpoint, and the next submission on that endpoint
+// adopts it instead of issuing a fresh transferIn. Ordering is preserved and no
+// data is lost.
+//
+// Lifetime needs care too. Once libusb completes a transfer the caller may free
+// it, while the browser callback still holds the usbi_transfer pointer, so the
+// callback consults the shared record before touching that memory.
+struct PendingTransfer {
+	std::mutex mutex;
+	// The transfer libusb is currently waiting on, or null once cancelled.
+	usbi_transfer* owner = nullptr;
+	// Set once the browser promise settles.
+	bool settled = false;
+	std::optional<PromiseResult> result;
+	// True once a PromiseResult has been handed to transfer_priv, so
+	// em_clear_transfer_priv knows whether there is one to destroy.
+	std::atomic<bool> delivered{false};
+	// Identifies the endpoint an orphaned read belongs to.
+	libusb_device_handle* dev_handle = nullptr;
+	uint8_t endpoint = 0;
+	bool is_read = false;
+	// The length this read was issued with. A read's size is fixed when
+	// transferIn() is called, so it may only be adopted by a transfer of the
+	// same length -- handing a short read to a longer transfer truncates the
+	// packet and desynchronises the endpoint.
+	int length = 0;
+};
+
+using PendingPtr = std::shared_ptr<PendingTransfer>;
+using EndpointKey = std::pair<libusb_device_handle*, uint8_t>;
+
+std::mutex pending_mutex;
+std::unordered_map<usbi_transfer*, PendingPtr> pending_by_transfer;
+std::map<EndpointKey, std::deque<PendingPtr>> orphaned_reads;
+
+// Hand a settled result to the libusb transfer waiting on it. Caller holds
+// pending->mutex.
+void deliverLocked(const PendingPtr& pending) {
+	auto* itransfer = pending->owner;
+	WebUsbTransferPtr(itransfer).emplace(std::move(*pending->result));
+	pending->result.reset();
+	pending->delivered.store(true);
+	usbi_signal_transfer_completion(itransfer);
+}
+
+PendingPtr findPending(usbi_transfer* itransfer) {
+	std::lock_guard<std::mutex> lock(pending_mutex);
+	auto it = pending_by_transfer.find(itransfer);
+	return it == pending_by_transfer.end() ? nullptr : it->second;
+}
+
+void forgetPending(usbi_transfer* itransfer) {
+	std::lock_guard<std::mutex> lock(pending_mutex);
+	pending_by_transfer.erase(itransfer);
+}
+
+// An earlier cancelled read on this endpoint, if any, whose bytes are still on
+// their way and must be handed to this transfer rather than dropped.
+PendingPtr adoptOrphanedRead(libusb_device_handle* handle,
+							 uint8_t endpoint,
+							 int length) {
+	std::lock_guard<std::mutex> lock(pending_mutex);
+	auto it = orphaned_reads.find({handle, endpoint});
+	if (it == orphaned_reads.end() || it->second.empty()) {
+		return nullptr;
+	}
+	// Only a same-sized read can be adopted safely. A mismatch means the caller
+	// cancelled a read of one size and is now asking for another, which USB
+	// framing cannot reconcile; there is nothing useful to do but leave the
+	// orphan alone and issue a fresh read.
+	if (it->second.front()->length != length) {
+		return nullptr;
+	}
+	auto pending = it->second.front();
+	it->second.pop_front();
+	return pending;
+}
