options:
    parameters:
        author: Marc
        copyright: ''
        description: Interactive real-time spectrum and waterfall display using gr-fosphor. A complex tone mixed with noise demonstrates fosphor's persistent color-density spectrum, live trace, and max hold. The browser uses WebGPU when available and automatically falls back to Qt 6 CPU plots; the editor console reports which renderer was selected.
        generate_options: qt_gui
        id: Fosphor_Spectrum_and_Waterfall
        title: Fosphor Spectrum and Waterfall
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: samp_rate
    id: variable
    parameters:
        value: int(1e6)
    states:
        coordinate: [220, 10]
        rotation: 0
        state: enabled
-   name: complex10
    id: blocks_interleaved_short_to_complex
    parameters:
        scale_factor: '32767'
        swap: 'False'
        vector_input: 'False'
    states:
        coordinate: [300, 170]
        rotation: 0
        state: enabled
-   name: fosphor
    id: fosphor_qt_sink_c
    parameters:
        freq_center: '0'
        freq_span: samp_rate
        gui_hint: ''
        wintype: window.WIN_BLACKMAN_hARRIS
    states:
        coordinate: [780, 170]
        rotation: 0
        state: enabled
-   name: source9
    id: blocks_file_source
    parameters:
        begin_tag: pmt.PMT_NIL
        file: /recordings/cellular_downlink_880MHz.sigmf-data
        length: '0'
        offset: '0'
        repeat: 'False'
        type: short
        vlen: '1'
    states:
        coordinate: [30, 140]
        rotation: 0
        state: enabled
-   name: throttle
    id: blocks_throttle2
    parameters:
        ignoretag: 'True'
        limit: time
        maximum: '0.05'
        samples_per_second: samp_rate
        type: complex
        vlen: '1'
    states:
        coordinate: [530, 150]
        rotation: 0
        state: enabled
connections:
- [complex10, '0', throttle, '0']
- [source9, '0', complex10, '0']
- [throttle, '0', fosphor, '0']
metadata:
    file_format: 1
    grc_version: 3.11.0.0
