options:
    parameters:
        author: Marc
        copyright: ''
        description: Receive and display spectrum from a HackRF One over WebUSB.
        generate_options: qt_gui
        id: HackRF_Receive_Example
        title: HackRF Receive Example
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: center_freq
    id: variable_qtgui_range
    parameters:
        comment: ''
        label: RF Frequency
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '1000000'
        step: '1000000'
        stop: '6000000000'
        value: '100000000'
        widget: counter_slider
    states:
        coordinate: [610, 10]
        rotation: 0
        state: enabled
-   name: lna_gain
    id: variable_qtgui_range
    parameters:
        comment: ''
        label: RX IF Gain
        min_len: '160'
        orient: QtCore.Qt.Horizontal
        rangeType: int
        start: '0'
        step: '8'
        stop: '40'
        value: '16'
        widget: counter_slider
    states:
        coordinate: [860, 10]
        rotation: 0
        state: enabled
-   name: vga_gain
    id: variable_qtgui_range
    parameters:
        comment: ''
        label: RX Baseband Gain
        min_len: '180'
        orient: QtCore.Qt.Horizontal
        rangeType: int
        start: '0'
        step: '2'
        stop: '62'
        value: '16'
        widget: counter_slider
    states:
        coordinate: [1110, 10]
        rotation: 0
        state: enabled
-   name: samp_rate
    id: variable_qtgui_chooser
    parameters:
        comment: ''
        label: Sample Rate
        labels: '["2 MHz", "2.5 MHz", "4 MHz", "5 MHz", "8 MHz", "10 MHz", "12.5 MHz", "16 MHz", "20 MHz"]'
        options: '[2000000, 2500000, 4000000, 5000000, 8000000, 10000000, 12500000, 16000000, 20000000]'
        orient: Qt.QVBoxLayout
        value: '10000000'
        widget: combo_box
    states:
        coordinate: [1370, 10]
        rotation: 0
        state: enabled
-   name: qtgui_freq_sink_x_0
    id: qtgui_freq_sink_x
    parameters:
        affinity: ''
        alias: ''
        alpha1: '1'
        alpha10: '1'
        alpha2: '1'
        alpha3: '1'
        alpha4: '1'
        alpha5: '1'
        alpha6: '1'
        alpha7: '1'
        alpha8: '1'
        alpha9: '1'
        autoscale: 'True'
        average: '0.1'
        axislabels: 'True'
        color1: '"blue"'
        color10: '"dark blue"'
        color2: '"red"'
        color3: '"green"'
        color4: '"black"'
        color5: '"cyan"'
        color6: '"magenta"'
        color7: '"yellow"'
        color8: '"dark red"'
        color9: '"dark green"'
        comment: ''
        ctrlpanel: 'False'
        fc: center_freq
        fftsize: '2048'
        grid: 'False'
        label1: ''
        label10: ''
        label2: ''
        label3: ''
        label4: ''
        label5: ''
        label6: ''
        label7: ''
        label8: ''
        label9: ''
        legend: 'True'
        marker1: '-1'
        marker10: '-1'
        marker2: '-1'
        marker3: '-1'
        marker4: '-1'
        marker5: '-1'
        marker6: '-1'
        marker7: '-1'
        marker8: '-1'
        marker9: '-1'
        maxoutbuf: '0'
        minoutbuf: '0'
        name: Spectrum
        nconnections: '1'
        bw: samp_rate
        style1: '1'
        style10: '1'
        style2: '1'
        style3: '1'
        style4: '1'
        style5: '1'
        style6: '1'
        style7: '1'
        style8: '1'
        style9: '1'
        tr_chan: '0'
        tr_level: '0'
        tr_mode: qtgui.TRIG_MODE_FREE
        tr_tag: ''
        update_time: '0.1'
        width1: '1'
        width10: '1'
        width2: '1'
        width3: '1'
        width4: '1'
        width5: '1'
        width6: '1'
        width7: '1'
        width8: '1'
        width9: '1'
        ymax: '10'
        ymin: '-140'
    states:
        coordinate: [390, 220]
        rotation: 0
        state: enabled
-   name: qtgui_waterfall_sink_x_0
    id: qtgui_waterfall_sink_x
    parameters:
        affinity: ''
        alias: ''
        alpha1: '1'
        alpha10: '1'
        alpha2: '1'
        alpha3: '1'
        alpha4: '1'
        alpha5: '1'
        alpha6: '1'
        alpha7: '1'
        alpha8: '1'
        alpha9: '1'
        axislabels: 'True'
        color1: '0'
