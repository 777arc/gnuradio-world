        label2: ''
        label3: ''
        label4: ''
        label5: ''
        label6: ''
        label7: ''
        label8: ''
        label9: ''
        legend: 'True'
        maxoutbuf: '0'
        minoutbuf: '0'
        name: Waterfall
        nconnections: '1'
        bw: samp_rate
        update_time: '0.1'
    states:
        coordinate: [390, 380]
        rotation: 0
        state: enabled
-   name: wasm_gui_layout_0
    id: wasm_gui_layout
    parameters:
        affinity: ''
        alias: ''
        columns: '12'
        comment: ''
        layout: '{"center_freq":[0,0,4,1],"lna_gain":[4,0,2,1],"vga_gain":[6,0,3,1],"samp_rate":[9,0,3,1],"qtgui_freq_sink_x_0":[0,1,12,3],"qtgui_waterfall_sink_x_0":[0,4,12,6]}'
        row_height: '60'
    states:
        coordinate: [320, 10]
        rotation: 0
        state: enabled
-   name: wasm_hackrf_source_0
    id: wasm_hackrf_source
    parameters:
        affinity: ''
        alias: ''
        amp: 'False'
        bandwidth: '0'
        bias_tee: 'False'
        center_freq: center_freq
        comment: ''
        device: ''
        lna_gain: lna_gain
        maxoutbuf: '0'
        minoutbuf: '0'
        samp_rate: samp_rate
        transfer_size: '262144'
        vga_gain: vga_gain
    states:
        coordinate: [10, 220]
        rotation: 0
        state: enabled
connections:
- [wasm_hackrf_source_0, '0', qtgui_freq_sink_x_0, '0']
- [wasm_hackrf_source_0, '0', qtgui_waterfall_sink_x_0, '0']
metadata:
