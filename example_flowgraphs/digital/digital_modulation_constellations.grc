connections:
- [chan_bpsk, '0', throttle_bpsk, '0']
- [chan_qam16, '0', throttle_qam16, '0']
- [chan_qpsk, '0', throttle_qpsk, '0']
- [mod_bpsk, '0', chan_bpsk, '0']
