        maxoutbuf: '0'
        minoutbuf: '0'
        mod_code: gray
        phase_bw: '0.0628'
        samples_per_symbol: sps
        timing_bw: '0.0628'
        verbose: 'False'
    states:
        coordinate: [1450, 330]
        rotation: 0
        state: enabled
-   name: qam_mod
