options:
    parameters:
        author: Marc
        copyright: ''
        description: Detects a DroneID frame in either of two 40 MS/s DJI Mavic 3 Classic SigMF recordings by correlating the root-600 Zadoff-Chu preamble. The cut19.51 File Source is enabled and cut21.99 is disabled; swap their enable states to test the other recording. Each source reads only the first 400,000 samples (10 ms), which contains its frame and keeps the R2 transfer small. These short cuts do not preserve the roughly 640 ms transmission cadence of a continuous capture.
        generate_options: qt_gui
        id: DJI_DroneID_frame_detector___Mavic_3_Classic_recordings
        title: "DJI DroneID frame detector \u2014 Mavic 3 Classic recordings"
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: capture_rate
    id: variable
    parameters:
        comment: ''
        value: '40000000'
    states:
        coordinate: [600, 10]
        rotation: 0
        state: enabled
-   name: channel_offset
    id: variable
    parameters:
        comment: ''
        value: '0'
    states:
