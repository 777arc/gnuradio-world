        update_time: '0.1'
        width1: '1'
        width10: '1'
        width2: '1'
        width3: '1'
        width4: '1'
        width5: '1'
        width6: '1'
        width7: '1'
        width8: '1'
        width9: '1'
        ylabel: Amplitude
        ymax: '1.5'
        ymin: '-1.5'
        yunit: '""'
    states:
        coordinate: [620, 390]
        rotation: 0
        state: enabled
-   name: tone
    id: analog_sig_source_x
    parameters:
        affinity: ''
        alias: ''
        amplitude: '1'
        comment: ''
        frequency: tone_freq
        maxoutbuf: '0'
        minoutbuf: '0'
        samp_rate: samp_rate
        type: float
        waveform: analog.GR_COS_WAVE
    states:
        coordinate: [10, 230]
        rotation: 0
        state: enabled
-   name: wasm_gui_layout_0
    id: wasm_gui_layout
    parameters:
        affinity: ''
        alias: ''
        columns: '12'
        comment: ''
        layout: '{}'
        row_height: '60'
    states:
        coordinate: [930, 220]
        rotation: 0
        state: enabled
connections:
- [throttle, '0', freq_sink, '0']
- [throttle, '0', time_sink, '0']
- [tone, '0', throttle, '0']
metadata:
    file_format: 1
    grc_version: 3.11.0.0
