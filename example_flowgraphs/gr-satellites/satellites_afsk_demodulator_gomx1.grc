options:
    parameters:
        author: Daniel Estevez
        copyright: ''
        description: AFSK demodulator component fed by the GOMX-1 recording
        generate_options: qt_gui
        id: afsk_demodulator_gomx1
        title: gr-satellites AFSK demodulator (GOMX-1)
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: samp_rate
    id: variable
    parameters:
        value: '48000'
    states:
        coordinate: [230, 10]
        rotation: 0
        state: enabled
-   name: recording
    id: blocks_file_source
    parameters:
        begin_tag: pmt.PMT_NIL
        file: /recordings/estevez/gomx_1.sigmf-data
        length: '0'
        offset: '0'
        repeat: 'False'
        type: short
        vlen: '1'
    states:
        coordinate: [10, 110]
        rotation: 0
        state: enabled
-   name: to_float
    id: blocks_short_to_float
    parameters:
        scale: '32767'
        vlen: '1'
    states:
        coordinate: [270, 140]
        rotation: 0
        state: enabled
-   name: afsk_demod
    id: satellites_afsk_demodulator
    parameters:
        af_carrier: '3600'
        baudrate: '4800'
        deviation: '-1200'
        iq: 'False'
        options: '""'
        samp_rate: samp_rate
    states:
        coordinate: [470, 120]
        rotation: 0
        state: enabled
-   name: head
    id: blocks_head
    parameters:
        num_items: '8000'
        type: float
    states:
        coordinate: [710, 140]
        rotation: 0
        state: enabled
-   name: soft_symbols
    id: qtgui_time_sink_x
    parameters:
        autoscale: 'False'
        grid: 'False'
        name: AFSK soft symbols
        nconnections: '1'
        samp_rate: '4800'
        size: '6000'
        type: float
        update_time: '0.1'
        ylabel: Amplitude
        ymax: '4'
        ymin: '-4'
        yunit: ''
    states:
        coordinate: [900, 130]
        rotation: 0
        state: enabled
connections:
- [recording, '0', to_float, '0']
- [to_float, '0', afsk_demod, '0']
- [afsk_demod, '0', head, '0']
- [head, '0', soft_symbols, '0']
metadata:
    file_format: 2
    grc_version: 3.11.0.0
