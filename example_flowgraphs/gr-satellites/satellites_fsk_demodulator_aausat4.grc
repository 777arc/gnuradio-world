options:
    parameters:
        author: Daniel Estevez
        copyright: ''
        description: FSK demodulator component fed by the AAUSAT-4 recording
        generate_options: qt_gui
        id: fsk_demodulator_aausat4
        title: gr-satellites FSK demodulator (AAUSAT-4)
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: samp_rate
    id: variable
    parameters:
        value: '48000'
    states:
        coordinate: [220, 20]
        rotation: 0
        state: enabled
-   name: recording
    id: blocks_file_source
    parameters:
        begin_tag: pmt.PMT_NIL
        file: /recordings/estevez/aausat_4.sigmf-data
        length: '0'
        offset: '0'
        repeat: 'False'
        type: short
        vlen: '1'
    states:
        coordinate: [30, 200]
        rotation: 0
        state: enabled
-   name: to_float
    id: blocks_short_to_float
    parameters:
        scale: '32767'
        vlen: '1'
    states:
        coordinate: [250, 200]
        rotation: 0
        state: enabled
-   name: fsk_demod
    id: satellites_fsk_demodulator
    parameters:
        baudrate: '4800'
        iq: 'False'
        options: '""'
        samp_rate: samp_rate
        subaudio: 'False'
    states:
        coordinate: [470, 200]
        rotation: 0
        state: enabled
-   name: soft_symbols
    id: qtgui_time_sink_x
    parameters:
        autoscale: 'False'
        grid: 'False'
        name: FSK soft symbols
        nconnections: '1'
        samp_rate: '4800'
        size: '12000'
        type: float
        update_time: '0.1'
        ylabel: Amplitude
        ymax: '4'
        ymin: '-4'
        yunit: ''
    states:
        coordinate: [700, 184]
        rotation: 0
        state: enabled
connections:
- [recording, '0', to_float, '0']
- [to_float, '0', fsk_demod, '0']
- [fsk_demod, '0', soft_symbols, '0']
metadata:
    file_format: 2
    grc_version: 3.11.0.0
