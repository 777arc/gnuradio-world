options:
  parameters:
    author: GNU Radio World
    comment: ''
    copyright: ''
    description: A deliberately extreme but runnable signal-processing maze built to rack up bals—a whole lot of Bálints—across a chaotic mix of simple operations and scalar stream types.
    generate_options: qt_gui
    id: Ridiculously_High_Flowgraph_Complexity
    scheduler: sts
    title: Ridiculously High Flowgraph Complexity
  states:
    coordinate: [10466, 6282]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '2000'
  states:
    coordinate: [1474, 6571]
    rotation: 180
    state: enabled
- name: gui_layout
  id: wasm_gui_layout
  parameters:
    columns: '12'
    layout: '{"time_sink":[0,0,12,6]}'
    row_height: '60'
  states:
    coordinate: [1183, 7828]
    rotation: 0
    state: enabled
- name: display_source
  id: analog_sig_source_x
  parameters:
    amp: '0.7'
    freq: '100'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    coordinate: [1360, 3790]
    rotation: 0
    state: enabled
- name: display_head
  id: blocks_head
  parameters:
    num_items: '4096'
    type: complex
    vlen: '1'
  states:
    coordinate: [1811, 5629]
    rotation: 0
    state: enabled
- name: time_sink
  id: qtgui_time_sink_x
  parameters:
    name: Active 100 Hz tone
    nconnections: '1'
    size: '512'
    srate: samp_rate
    type: complex
    update_time: '0.1'
    ymax: '1'
    ymin: '-1'
  states:
    coordinate: [7488, 817]
    rotation: 0
    state: enabled
- name: terminator
  id: blocks_null_sink
