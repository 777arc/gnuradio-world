options:
    parameters:
        author: Daniel Estevez
        copyright: ''
        description: BPSK demodulator component fed by the LilacSat-1 recording
        generate_options: qt_gui
        id: bpsk_demodulator_lilacsat1
        title: gr-satellites BPSK demodulator (LilacSat-1)
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: samp_rate
    id: variable
    parameters:
        value: '48000'
    states:
        coordinate: [220, 20]
        rotation: 0
        state: enabled
-   name: recording
    id: blocks_file_source
    parameters:
        begin_tag: pmt.PMT_NIL
        file: /recordings/estevez/lilacsat1.sigmf-data
        length: '0'
        offset: '0'
        repeat: 'False'
        type: short
        vlen: '1'
    states:
        coordinate: [30, 200]
        rotation: 0
        state: enabled
-   name: to_float
    id: blocks_short_to_float
    parameters:
        scale: '32767'
        vlen: '1'
    states:
        coordinate: [250, 200]
        rotation: 0
        state: enabled
-   name: bpsk_demod
    id: satellites_bpsk_demodulator
    parameters:
        baudrate: '9600'
        differential: 'False'
        f_offset: '12000'
        iq: 'False'
        manchester: 'False'
        options: '""'
        samp_rate: samp_rate
    states:
        coordinate: [470, 200]
        rotation: 0
        state: enabled
-   name: skiphead
    id: blocks_skiphead
    parameters:
        num_items: '10000'
        type: float
        vlen: '1'
    states:
        coordinate: [700, 200]
        rotation: 0
        state: enabled
-   name: head
    id: blocks_head
    parameters:
        num_items: '20000'
        type: float
    states:
        coordinate: [880, 200]
        rotation: 0
        state: enabled
-   name: soft_symbols
    id: qtgui_time_sink_x
    parameters:
        autoscale: 'False'
        grid: 'False'
        name: BPSK soft symbols
        nconnections: '1'
        samp_rate: '9600'
        size: '20000'
        type: float
        update_time: '0.1'
        ylabel: Amplitude
        ymax: '4'
        ymin: '-4'
        yunit: ''
    states:
        coordinate: [1060, 184]
        rotation: 0
        state: enabled
connections:
- [recording, '0', to_float, '0']
- [to_float, '0', bpsk_demod, '0']
- [bpsk_demod, '0', skiphead, '0']
- [skiphead, '0', head, '0']
- [head, '0', soft_symbols, '0']
metadata:
    file_format: 2
    grc_version: 3.11.0.0
