    parameters:
        affinity: ''
        alias: ''
        comment: ''
        display: 'True'
        filter: '"js_tag"'
        name: js_tag_output
        num_inputs: '1'
        type: byte
        vlen: '1'
    states:
        coordinate: [910, 180]
        rotation: 0
        state: enabled
-   name: tag_source
    id: blocks_vector_source_x
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        maxoutbuf: '0'
        minoutbuf: '0'
        repeat: 'True'
        tags: '[input_tag]'
        type: byte
