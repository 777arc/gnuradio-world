options:
    parameters:
        author: Marc
        comment: ''
        copyright: ''
        description: Play synth notes and chords on the SamSonic musical keyboard
        generate_options: qt_gui
        id: SamSonic_Musical_Keyboard
        title: SamSonic Musical Keyboard
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: samp_rate
    id: variable
    parameters:
        comment: ''
        value: '48000'
    states:
        coordinate: [740, 10]
        rotation: 0
        state: enabled
-   name: blocks_keep_one_in_n_0
    id: blocks_keep_one_in_n
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        maxoutbuf: '16'
        minoutbuf: '0'
        n: '1'
