        alias: ''
        amplitude: '0.18'
        attack_ms: '5'
        comment: ''
        decay_ms: '180'
        default_chord: none
        filter_cutoff_hz: '700'
        filter_envelope_octaves: '3'
        filter_resonance: '0.25'
