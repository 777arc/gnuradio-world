        maxoutbuf: '16'
        minoutbuf: '0'
        octaves: '3'
        release_ms: '120'
        samp_rate: samp_rate
        saturation_drive: '1'
        sustain_level: '0.6'
        tuning_hz: '440'
        unison_detune_cents: '9'
        unison_voices: '2'
        waveform: saw
    states:
        coordinate: [20, 160]
        rotation: 0
        state: enabled
-   name: note_0
    id: note
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        note: Enjoy! You can also play notes using the keyboard!  Try selection a chord for more fun.
