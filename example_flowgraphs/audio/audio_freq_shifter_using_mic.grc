options:
    parameters:
        author: Mike Warot
        comment: ''
        copyright: ''
        description: This is a really simple audio frequency shifter
        generate_options: qt_gui
        id: Audio_Frequency_Shifter
        title: Audio Frequency Shifter
    states:
        coordinate: [10, 10]
        rotation: 0
        state: enabled
blocks:
-   name: offset_freq
    id: variable_qtgui_range
    parameters:
        comment: ''
        label: Frequency Offset
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '-2000'
        step: '1'
        stop: '2000'
        value: '0'
        widget: counter_slider
    states:
        coordinate: [320, 550]
        rotation: 0
        state: enabled
-   name: samp_rate
    id: variable
    parameters:
        comment: ''
        value: '48000'
    states:
        coordinate: [310, 20]
        rotation: 0
        state: enabled
-   name: analog_sig_source_x_0
    id: analog_sig_source_x
    parameters:
        affinity: ''
        alias: ''
        amp: '1'
        comment: ''
        freq: offset_freq
        maxoutbuf: '0'
        minoutbuf: '0'
        offset: '0'
        phase: '0'
        samp_rate: samp_rate
        type: complex
        waveform: analog.GR_COS_WAVE
    states:
        coordinate: [330, 380]
        rotation: 0
        state: enabled
-   name: audio_sink_0
    id: audio_sink
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        device_name: ''
        num_inputs: '1'
        ok_to_block: 'True'
        samp_rate: samp_rate
    states:
        coordinate: [1100, 220]
        rotation: 0
        state: enabled
-   name: audio_source_0
    id: audio_source
