{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gnuradio-world-sigmf-indexer",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "gnuradio-wasm-recordings"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "gnuradio-world-sigmf-events",
        "max_batch_size": 100,
        "max_batch_timeout": 60,
        "max_concurrency": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
