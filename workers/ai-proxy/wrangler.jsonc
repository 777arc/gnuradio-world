{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gnuradio-world-ai-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "routes": [
    {
      "pattern": "ai.gnuradioworld.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIMITER",
        "class_name": "TokenLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TokenLimiter"]
    }
  ],
  "vars": {
    // The OpenAI upstream, at /v1 — billed by the token, so metered by it.
    "MODELS": "gpt-5.6-luna",
    "TOKENS_PER_MINUTE": "1000000",
    "PER_USER_DAILY_CAP": "1000000",
    "GLOBAL_DAILY_TOKEN_CAP": "5000000",
    // The OpenRouter upstream, at /openrouter/v1 — free models only, so what
    // runs out is a request allowance rather than a bill. Keep the daily cap
    // under the free-tier allowance on the OpenRouter account itself.
    "OPENROUTER_MODELS": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "OPENROUTER_REQUESTS_PER_MINUTE": "15",
    "OPENROUTER_DAILY_REQUEST_CAP": "900",
    // Shared by both.
    "MAX_BODY_BYTES": "1048576",
    "MAX_COMPLETION_TOKENS": "50000",
    "OUTPUT_ESTIMATE": "2000"
  },
  "observability": {
    "enabled": true
  }
}
