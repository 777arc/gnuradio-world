{
  "name": "gnuradio-wasm-editor",
  "private": true,
  "version": "0.1.0",
  "author": "Marc Lichtman",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run blocks:check && npm run examples",
    "blocks": "python3 ../runner/gen_registry.py && python3 gen/gen_blocklib.py public/blocks.json",
    "blocks:check": "node -e \"if(!require('fs').existsSync('public/blocks.json')){console.error('editor/public/blocks.json is missing: it is generated, not committed. Run: npm run blocks');process.exit(1)}\"",
    "examples": "node gen/gen_example_pages.mjs",
    "build": "vite build",
    "prebuild": "npm run blocks:check && npm run examples",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/recording/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "node test/run.mjs",
    "pretest": "npm run blocks",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "18.2.33",
    "@types/react-dom": "18.2.14",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "4.12.10",
    "postcss": "8.4.44",
    "tailwindcss": "3.4.10",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@heroicons/react": "2.1.5",
    "@js-temporal/polyfill": "0.4.4",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "4.36.1",
    "ajv": "8.12.0",
    "ajv-formats": "2.1.1",
    "codemirror": "^6.0.2",
    "fftshift": "1.0.1",
    "js-yaml": "^5.2.2",
    "konva": "9.3.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.4.1",
    "react-konva": "18.2.10",
    "react-konva-utils": "1.0.6",
    "react-router-dom": "6.26.1",
    "usehooks-ts": "^2.9.1"
  }
}
